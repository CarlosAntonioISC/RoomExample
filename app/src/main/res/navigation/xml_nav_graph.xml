<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/xml_nav_graph"
    app:startDestination="@id/contactList">

    <fragment
        android:id="@+id/contactList"
        android:name="com.example.roomexample.ui.xml.ContactListFragment"
        android:label="Lista de contactos">
        <action
            android:id="@+id/action_contactList_to_addContactSheet"
            app:destination="@id/addContactBottomSheet" />
        <action
            android:id="@+id/action_contactList_to_contactDetail"
            app:destination="@id/contactDetail" />
    </fragment>

    <fragment
        android:id="@+id/contactDetail"
        android:name="com.example.roomexample.ui.xml.ContactDetailFragment"
        android:label="Detalle de contacto">
        <argument
            android:name="contactId"
            app:argType="integer"
            android:defaultValue="-1" />
        <action
            android:id="@+id/action_contactDetail_to_addContactSheet"
            app:destination="@id/addContactBottomSheet" />
    </fragment>

    <dialog
        android:id="@+id/addContactBottomSheet"
        android:name="com.example.roomexample.ui.xml.AddContactBottomSheetFragment"
        android:label="@string/title_add_contact"
        app:layout="@layout/bottom_sheet_add_contact">
        <argument
            android:name="contactId"
            app:argType="integer"
            android:defaultValue="-1" />
        <argument
            android:name="initialName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="initialPhone"
            app:argType="string"
            android:defaultValue="" />
    </dialog>
</navigation>
